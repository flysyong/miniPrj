# 복사해서 .env로 사용 (값이 없으면 상위 C:\AX-SDS\.env 값을 사용)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# 모델 (비우면 src/config.py 기본값 사용, 접근 불가 시 여기서 교체)
LLM_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
LLM_FALLBACK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
JUDGE_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
